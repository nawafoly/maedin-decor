[debug] [2026-06-21T12:38:36.517Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/maedin-decor/rulesets {"name":"projects/maedin-decor/rulesets/e7b36317-b344-4f29-9312-53d79b3bbe57","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function signedIn() {\n      return request.auth != null;\n    }\n\n    function ownerEmail() {\n      return signedIn() && request.auth.token.email == \"nawafoly0@gmail.com\";\n    }\n\n    function userPath() {\n      return /databases/$(database)/documents/users/$(request.auth.uid);\n    }\n\n    function hasProfile() {\n      return signedIn() && exists(userPath());\n    }\n\n    function userRole() {\n      return hasProfile() ? get(userPath()).data.role : \"\";\n    }\n\n    function isAdmin() {\n      return ownerEmail() || userRole() in [\"admin\", \"owner\"];\n    }\n\n    function isOwner() {\n      return ownerEmail() || userRole() == \"owner\";\n    }\n\n    function ownsUserField() {\n      return signedIn() && request.resource.data.userId == request.auth.uid;\n    }\n\n    match /users/{uid} {\n      allow create: if signedIn()\n        && request.auth.uid == uid\n        && (\n          request.resource.data.role == \"customer\"\n          || (ownerEmail() && request.resource.data.role in [\"admin\", \"owner\"])\n        );\n      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);\n      allow update: if isAdmin()\n        || (\n          signedIn()\n          && request.auth.uid == uid\n          && request.resource.data.role == resource.data.role\n          && request.resource.data.accountDisabled == resource.data.accountDisabled\n        );\n      allow delete: if isOwner();\n    }\n\n    match /orders/{orderId} {\n      allow create: if isAdmin() || ownsUserField();\n      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);\n      allow update, delete: if isAdmin();\n    }\n\n    match /invoices/{invoiceId} {\n      allow read: if isAdmin() || (signedIn() && resource.data.customerId == request.auth.uid);\n      allow create, update, delete: if isAdmin();\n    }\n\n    match /paymentTransactions/{transactionId} {\n      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);\n      allow create, update, delete: if false;\n    }\n\n    match /uploadsMetadata/{uploadId} {\n      allow create: if ownsUserField();\n      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);\n      allow update, delete: if isAdmin();\n    }\n\n    match /{collectionName}/{documentId} {\n      allow read: if collectionName in [\"projects\", \"designs\", \"services\", \"packages\", \"siteSettings\"];\n      allow create, update, delete: if collectionName in [\"projects\", \"designs\", \"services\", \"packages\", \"siteSettings\"]\n        && isAdmin();\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-06-21T12:38:36.188559Z","metadata":{"services":["cloud.firestore"]}}
